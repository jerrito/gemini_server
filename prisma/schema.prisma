generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Subject {
  English
  Mathematics
  Science
  Computing
}

enum Role {
  User
  Admin
}

model LearningLink {
  id     Int    @id @default(autoincrement())
  link   String @unique
  hasExpired Boolean? @default(false)
  createdAt DateTime? @default(now())
  userId Int
  user   User   @relation(references: [id], fields: [userId], onDelete: Cascade)
 @@map("learning_link")
}

model Admin {
  id           Int        @id @default(autoincrement())
  isApproved   Boolean?   @default(false)
  studentCount Int?       @default(0)
  subject      Subject    @default(English)
  userId       Int        @unique
  user         User       @relation(references: [id], fields: [userId], onDelete: Cascade)
  learning     Learning[]

  @@map("admin")
}

model User {
  id                Int             @id @default(autoincrement())
  userName          String          @unique
  email             String          @unique
  password          String
  isStudent         Boolean?        @default(false)
  profile           String?         @default("")
  role              Role?           @default(User)
  dataGenerated     dataGenerated[]
  blackListedTokens Tokens[]
  assessment        Assessment[]
  admin             Admin?
  learningLink      LearningLink[]

  @@map("user")
}

model Assessment {
  id      Int    @id @default(autoincrement())
  userId  Int
  subject String
  score   Int
  user    User   @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("assessment")
}

model Learning {
  id                 Int                @id @default(autoincrement())
  adminId            Int
  admin              Admin?             @relation(references: [id], fields: [adminId], onDelete: SetDefault)
  learningResources LearningResource[]

  @@map("learning")
}

model LearningResource {
  id         Int             @id @default(autoincrement())
  createdAt  DateTime?        @default(now())
  url        String?
  pages      Int?            @default(0)
  title      String
  extension  String?          @default(".txt")
  data       String?
  learningId Int
  learning   Learning        @relation(references: [id], fields: [learningId])
 @@map("learning_resource")
}

model Tokens {
  id      Int     @id @default(autoincrement())
  token   String  @unique
  userId  Int
  isValid Boolean @default(true)
  user    User    @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("blacklisted_tokens")
}

model dataGenerated {
  id        Int       @id @default(autoincrement())
  data      String
  title     String
  hasImage  Boolean   @default(false)
  dataImage String?
  dateTime  DateTime? @default(now())
  userId    Int
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("data_generated")
}
