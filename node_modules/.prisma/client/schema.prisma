generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  User
  Admin
}

model Admin {
  id       Int    @id @default(autoincrement())
  userName String @unique
  email    String @unique
  password String
  profile  String @default("")
  user     User[]

  dataGenerated     dataGenerated[]
  blackListedTokens Tokens[]

  studentCount Int
  subject      String
  learning     Learning[]
  assessment   Assessment[]

  @@map("admin")
}

model Assessment {
  id      Int    @id @default(autoincrement())
  userId  Int
  subject String
  score   Int
  adminId Int
  admin   Admin  @relation(references: [id], fields: [adminId], onDelete: Cascade)

  @@map("assessment")
}

model User {
  id                Int             @id @default(autoincrement())
  userName          String          @unique
  email             String          @unique
  password          String
  isStudent         Boolean         @default(false)
  profile           String          @default("")
  dataGenerated     dataGenerated[]
  blackListedTokens Tokens[]
  adminId           Int @default(0)
  admin             Admin           @relation(references: [id], fields: [adminId], onDelete: Cascade)

  @@map("user")
}

model Learning {
  id        Int    @id @default(autoincrement())
  title     String
  data      String
  url       String
  extension String @default(".txt")
  pages     Int    @default(0)
  adminId   Int
  admin     Admin  @relation(references: [id], fields: [adminId], onDelete: Cascade)

  @@map("LearningTable")
}

model Tokens {
  id      Int     @id @default(autoincrement())
  token   String  @unique
  userId  Int
  adminId Int @default(0)
  isValid Boolean @default(true)
  user    User    @relation(references: [id], fields: [userId], onDelete: Cascade)
  admin   Admin   @relation(references: [id], fields: [adminId], onDelete: Cascade)

  @@map("blacklisted_tokens")
}

model dataGenerated {
  id        Int       @id @default(autoincrement())
  data      String
  title     String
  hasImage  Boolean   @default(false)
  dataImage String?
  dateTime  DateTime? @default(now())
  userId    Int
  adminId   Int @default(0)
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  admin     Admin     @relation(references: [id], fields: [adminId], onDelete: Cascade)

  @@map("dataGenerated")
}
